{
  "name": "sendero",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Local-first travel planner with personalized itineraries, weather, events, reservations, and daily routes.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run build:ui",
    "build:planning-protocol": "node scripts/build-planning-protocol.mjs",
    "build:ui": "npm run build:planning-protocol && node web/build.mjs",
    "build:vercel": "node scripts/vercel-build.mjs",
    "check": "npm run typecheck:convex && npm run check:env:example && npm test && npm run smoke:local && npm run check:generated && npm run check:diff",
    "check:diff": "git diff --check",
    "check:env": "node scripts/check-env.mjs --profile local --env-file .env.local",
    "check:env:example": "node scripts/check-env.mjs --example",
    "check:generated": "node scripts/check-generated.mjs",
    "ci": "npm run check && git diff --exit-code",
    "dev": "npm run build:ui && node server/http.mjs",
    "preview:ui": "npm run build:ui && node web/preview.mjs",
    "smoke:local": "node scripts/smoke.mjs",
    "smoke:remote": "node scripts/smoke.mjs --remote",
    "test": "npm run build:ui && node --test server/*.test.mjs web/*.test.mjs",
    "convex:dev": "convex dev",
    "convex:check": "convex dev --once",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.102.8",
    "convex": "^1.31.7",
    "gsap": "^3.15.0",
    "hono": "^4.13.2",
    "jose": "^6.2.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
